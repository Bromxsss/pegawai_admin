generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model aktivitas_kelas {
  id_aktivitas_kelas  Int     @id @default(autoincrement())
  judul_akt_kelas     String? @db.VarChar(100)
  deskripsi_akt_kelas String? @db.Text
}

model data_change_requests {
  id              Int            @id @default(autoincrement())
  id_pegawai      Int            @db.SmallInt
  field_name      String
  current_value   String         @db.Text
  requested_value String         @db.Text
  reason          String         @db.Text
  status          String
  requested_at    DateTime       @db.DateTime(0)
  processed_at    DateTime?      @db.DateTime(0)
  admin_notes     String?        @db.Text
  simpeg_pegawai  simpeg_pegawai @relation(fields: [id_pegawai], references: [id_pegawai], onDelete: NoAction, onUpdate: NoAction, map: "data_change_requests_ibfk_1")

  @@index([id_pegawai], map: "id_pegawai")
}

model kol_agama {
  id_agama       Int              @id @default(autoincrement()) @db.TinyInt
  nama_agama     String           @db.VarChar(100)
  id_feeder      Int?             @db.TinyInt
  simpeg_pegawai simpeg_pegawai[]
}

model kol_darah {
  id_darah       Int              @id @default(autoincrement()) @db.SmallInt
  nama_darah     String           @db.Text
  simpeg_pegawai simpeg_pegawai[]
}

model kol_jk {
  id_jk          Int              @id @default(autoincrement()) @db.SmallInt
  nama_jk        String           @db.Text
  ket            String           @db.VarChar(15)
  simpeg_pegawai simpeg_pegawai[]
}

model kol_jurusan {
  id_jurusan     Int              @id @default(0) @db.TinyInt
  nama_jurusan   String           @db.VarChar(100)
  id_kajur       Int              @db.SmallInt
  id_sekjur      Int              @db.SmallInt
  visi           String           @db.Text
  misi           String           @db.Text
  kol_prodi      kol_prodi[]
  simpeg_pegawai simpeg_pegawai[]
}

model kol_kabupaten {
  id_kabupaten   String           @id @db.Char(10)
  nama_kabupaten String           @db.VarChar(50)
  id_provinsi    String?          @db.Char(2)
  kol_provinsi   kol_provinsi?    @relation(fields: [id_provinsi], references: [id_prov], onDelete: NoAction, onUpdate: NoAction, map: "kol_kabupaten_ibfk_1")
  simpeg_pegawai simpeg_pegawai[]

  @@index([id_provinsi], map: "id_provinsi")
}

model kol_pendidikan {
  id_pendidikan   String           @id @db.Char(2)
  nama_pendidikan String?          @db.VarChar(50)
  simpeg_pegawai  simpeg_pegawai[]
}

model kol_prodi {
  id_prodi              Int              @id @default(0) @db.TinyInt
  kode_prodi            String           @db.VarChar(11)
  id_prodi_bppp         String           @default("") @db.Char(6)
  id_jurusan            Int              @db.TinyInt
  nama_prodi            String           @db.VarChar(100)
  nama_konsentrasi      String           @db.VarChar(100)
  bidang                String           @db.VarChar(100)
  singkatan             String           @db.VarChar(100)
  id_kaprodi            Int              @db.SmallInt
  jenjang               String           @db.VarChar(5)
  akreditasi            String?          @db.VarChar(100)
  no_sk_dikti           String?          @db.VarChar(100)
  tgl_sk_dikti          DateTime?        @db.Date
  no_sk_ban             String?          @db.VarChar(100)
  tgl_sk_ban            DateTime?        @db.Date
  kadaluarsa_akreditasi DateTime         @db.Date
  aktif                 kol_prodi_aktif
  no                    Int              @db.TinyInt
  visi                  String           @db.Text
  misi                  String           @db.Text
  prefix                String           @default("") @db.Char(3)
  kol_jurusan           kol_jurusan      @relation(fields: [id_jurusan], references: [id_jurusan], onDelete: NoAction, onUpdate: NoAction, map: "kol_prodi_ibfk_1")
  simpeg_pegawai        simpeg_pegawai[]

  @@index([id_jurusan], map: "id_jurusan")
}

model kol_provinsi {
  id_prov        String           @id @db.Char(2)
  nama_prov      String           @db.TinyText
  kol_kabupaten  kol_kabupaten[]
  simpeg_pegawai simpeg_pegawai[]
}

model kol_status {
  id_status                 Int                         @id @default(autoincrement()) @db.SmallInt
  nama_status               String                      @db.VarChar(15)
  simpeg_riwayat_pendidikan simpeg_riwayat_pendidikan[]
}

model kol_status_hidup {
  id_status_hidup   String           @id @db.Char(1)
  nama_status_hidup String?          @db.VarChar(50)
  simpeg_pegawai    simpeg_pegawai[]
}

model kol_wilayah {
  id_wil           String           @id @db.Char(8)
  nm_wil           String           @db.VarChar(50)
  id_induk_wilayah String?          @db.VarChar(50)
  id_level_wil     Int
  simpeg_pegawai   simpeg_pegawai[]
}

model simpeg_bagian {
  id_bagian      Int              @id @default(autoincrement()) @db.TinyInt
  nama_bagian    String           @db.VarChar(20)
  simpeg_pegawai simpeg_pegawai[]
}

model simpeg_jabatan_fungsional {
  id_jabatan_fungsional   Int              @id
  nama_jabatan_fungsional String           @db.VarChar(30)
  simpeg_pegawai          simpeg_pegawai[]
}

model simpeg_jabatan_struktural {
  id_jabatan_struktural   Int              @id @default(autoincrement()) @db.SmallInt
  id_jurusan              Int?
  nama_jabatan_struktural String           @default("") @db.VarChar(100)
  simpeg_pegawai          simpeg_pegawai[]
}

model simpeg_level_pendidikan {
  id_level_pendidikan       Int                         @id @default(autoincrement()) @db.SmallInt
  nama_level_pendidikan     String                      @db.VarChar(50)
  simpeg_riwayat_pendidikan simpeg_riwayat_pendidikan[]
}

model simpeg_pangkat_gol_ruang {
  id_pangkat_gol_ruang   Int    @id @default(autoincrement())
  nama_pangkat_gol_ruang String @db.VarChar(50)
  simpeg_riwayat_pangkat simpeg_riwayat_pangkat[]
}

model simpeg_pegawai {
  id_pegawai                Int                         @id @default(autoincrement()) @db.SmallInt
  nama_pegawai              String                     @db.VarChar(60)
  jk                        Int?                         @db.SmallInt
  id_agama                  Int?                         @db.TinyInt
  tempat_lahir              String?                     @db.VarChar(40)
  tgl_lahir                 DateTime?                   @db.Date
  nidn                      String                      @db.Char(10)
  nip                       String                      @db.Char(18)
  NUPTK                     String                    @db.VarChar(20)
  no_ktp                    String?                      @db.Char(16)
  no_kk                     String?                      @db.Char(16)
  gol_darah                 Int?                         @db.SmallInt
  id_pendidikan             String?                      @db.Char(2)
  id_status_hidup           String                     @db.Char(1)
  alamat                    String?                      @db.VarChar(255)
  kota                      String?                     @db.VarChar(100)
  kode_pos                  String?                     @db.VarChar(5)
  id_wil                    String?                     @db.Char(8)
  id_kabupaten              String?                      @db.Char(10)
  id_prov                   String?                      @db.Char(2)
  handphone                 String?                      @default("") @db.VarChar(20)
  email_poliban             String?                      @db.VarChar(150)
  id_jabatan_struktural     Int                         @db.SmallInt
  id_jabatan_fungsional     Int
  id_status_pegawai         Int                         @db.TinyInt
  id_jurusan                Int                        @db.TinyInt
  id_bagian                 Int                         @db.TinyInt
  id_prodi                  Int                       @db.TinyInt
  foto                      String?                     @default("blm_ada_foto.jpg") @db.VarChar(255)
  data_change_requests      data_change_requests[]
  simpeg_jabatan_fungsional simpeg_jabatan_fungsional   @relation(fields: [id_jabatan_fungsional], references: [id_jabatan_fungsional], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_1")
  kol_status_hidup          kol_status_hidup           @relation(fields: [id_status_hidup], references: [id_status_hidup], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_10")
  kol_kabupaten             kol_kabupaten?               @relation(fields: [id_kabupaten], references: [id_kabupaten], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_11")
  kol_provinsi              kol_provinsi?                @relation(fields: [id_prov], references: [id_prov], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_14")
  kol_pendidikan            kol_pendidikan?              @relation(fields: [id_pendidikan], references: [id_pendidikan], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_15")
  kol_wilayah               kol_wilayah?                @relation(fields: [id_wil], references: [id_wil], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_16")
  kol_agama                 kol_agama?                   @relation(fields: [id_agama], references: [id_agama], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_17")
  kol_darah                 kol_darah?                   @relation(fields: [gol_darah], references: [id_darah], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_18")
  simpeg_jabatan_struktural simpeg_jabatan_struktural   @relation(fields: [id_jabatan_struktural], references: [id_jabatan_struktural], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_2")
  simpeg_bagian             simpeg_bagian               @relation(fields: [id_bagian], references: [id_bagian], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_3")
  simpeg_status_pegawai     simpeg_status_pegawai       @relation(fields: [id_status_pegawai], references: [id_status_pegawai], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_4")
  kol_jk                    kol_jk?                      @relation(fields: [jk], references: [id_jk], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_7")
  kol_jurusan               kol_jurusan                @relation(fields: [id_jurusan], references: [id_jurusan], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_8")
  kol_prodi                 kol_prodi                 @relation(fields: [id_prodi], references: [id_prodi], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_pegawai_ibfk_9")
  simpeg_riwayat_pangkat    simpeg_riwayat_pangkat[]
  simpeg_riwayat_pendidikan simpeg_riwayat_pendidikan[]

  @@index([gol_darah], map: "gol_darah")
  @@index([id_agama], map: "id_agama")
  @@index([id_bagian], map: "id_bagian")
  @@index([id_jabatan_fungsional], map: "id_jabatan_fungsional")
  @@index([id_jabatan_struktural], map: "id_jabatan_struktural")
  @@index([id_jurusan], map: "id_jurusan")
  @@index([id_kabupaten], map: "id_kabupaten")
  @@index([id_pendidikan], map: "id_pendidikan")
  @@index([id_prodi], map: "id_prodi")
  @@index([id_prov], map: "id_prov")
  @@index([id_status_hidup], map: "id_status_hidup")
  @@index([id_status_pegawai], map: "id_status_pegawai")
  @@index([id_wil], map: "id_wil")
  @@index([jk], map: "jk")
  @@index([nip], map: "nip")
}

model simpeg_pendanaan {
  id_pendanaan              Int                         @id @default(autoincrement()) @db.SmallInt
  pendanaan                 String                      @db.VarChar(50)
  simpeg_riwayat_pendidikan simpeg_riwayat_pendidikan[]
}

model simpeg_riwayat_pangkat {
  id_riwayat_pangkat    Int            @id @default(autoincrement())
  id_pegawai            Int            @db.SmallInt
  id_pangkat_gol_ruang  Int            
  tmt_pangkat_gol_ruang DateTime?      @db.Date
  no_sk                 String         @db.VarChar(30)
  tgl_sk                DateTime?      @db.Date
  pejabat_penetap       String         @db.VarChar(50)
  simpeg_pegawai        simpeg_pegawai @relation(fields: [id_pegawai], references: [id_pegawai], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_riwayat_pangkat_ibfk_3")
  simpeg_pangkat_gol_ruang simpeg_pangkat_gol_ruang @relation(fields: [id_pangkat_gol_ruang], references: [id_pangkat_gol_ruang])
  @@index([id_pangkat_gol_ruang], map: "id_pangkat_gol_ruang")
  @@index([id_pegawai], map: "id_pegawai")
}

model simpeg_riwayat_pendidikan {
  id_riwayat_pendidikan   Int                     @id @default(autoincrement())
  id_pegawai              Int                     @db.SmallInt
  id_level_pendidikan     Int                     @db.SmallInt
  nama_pendidikan         String                  @db.VarChar(100)
  total_sks               Int
  ipk                     Decimal                 @db.Decimal(4, 2)
  fakultas_jurusan_prodi  String                  @db.VarChar(100)
  tempat                  String                  @db.VarChar(100)
  nama_pimpinan           String                  @db.VarChar(100)
  id_pendanaan            Int                     @db.SmallInt
  id_status               Int                     @db.SmallInt
  thn_masuk               Int                     @db.Year
  thn_lulus               Int                     @db.Year
  simpeg_level_pendidikan simpeg_level_pendidikan @relation(fields: [id_level_pendidikan], references: [id_level_pendidikan], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_riwayat_pendidikan_ibfk_2")
  simpeg_pendanaan        simpeg_pendanaan        @relation(fields: [id_pendanaan], references: [id_pendanaan], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_riwayat_pendidikan_ibfk_3")
  kol_status              kol_status              @relation(fields: [id_status], references: [id_status], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_riwayat_pendidikan_ibfk_4")
  simpeg_pegawai          simpeg_pegawai          @relation(fields: [id_pegawai], references: [id_pegawai], onDelete: NoAction, onUpdate: NoAction, map: "simpeg_riwayat_pendidikan_ibfk_5")

  @@index([id_level_pendidikan], map: "id_level_pendidikan")
  @@index([id_pegawai], map: "id_pegawai")
  @@index([id_pendanaan], map: "id_pendanaan")
  @@index([id_status], map: "id_status")
}

model simpeg_status_pegawai {
  id_status_pegawai   Int              @id @default(autoincrement()) @db.TinyInt
  nama_status_pegawai String           @default("") @db.VarChar(50)
  aktif               String           @db.Char(1)
  simpeg_pegawai      simpeg_pegawai[]
}

model user_level {
  id_level   Boolean @id
  nama_level String  @db.Char(20)
}

model users {
  id_user      Int          @id @default(autoincrement())
  level        Int          @db.SmallInt
  username     String       @unique @db.VarChar(35)
  password     String?      @db.VarChar(100)
  nama_lengkap String?      @db.VarChar(100)
  email        String?      @db.VarChar(100)
  no_telp      String?      @db.VarChar(100)
  aktif        users_aktif
  blokir       users_blokir @default(N)
  ket          String?      @db.VarChar(255)
}

enum users_aktif {
  Y
  T
}

enum users_blokir {
  Y
  N
}

enum kol_prodi_aktif {
  Y
  T
}
